# ==============================================================================
# Environment Configuration for Docker Compose Deployment (Coolify / VPS)
# ==============================================================================

# Database Configuration
DB_USER=root
DB_PASSWORD=root
DB_NAME=rmc_gate_system

# Ports on the Host (adjust if running behind reverse proxy or port conflict)
FRONTEND_PORT=80
BACKEND_PORT=3001
DB_EXTERNAL_PORT=3306
PMA_PORT=8081

# CORS Configuration (comma-separated origins, or * for all HTTPS domains)
CORS_ORIGIN=*

# Optional: Domains for Coolify / Traefik Automated SSL (Let's Encrypt)
# DOMAIN=rmc.yourdomain.com
# API_DOMAIN=api.rmc.yourdomain.com
# PMA_DOMAIN=pma.rmc.yourdomain.com
